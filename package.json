{
  "name": "jskids-browser",
  "version": "1.0.0",
  "description": "Navegador seguro e controlado para educação, trabalho e ambiente corporativo. Com recursos de segurança avançados, controle parental e monitoramento.",
  "author": {
    "name": "Jean Gomes",
    "email": "jeanbyte2030@gmail.com"
  },
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --linux AppImage",
    "dist:fast": "electron-builder --linux AppImage --dir",
    "build": "electron-builder --linux AppImage",
    "build:linux": "electron-builder --linux AppImage",
    "build:windows": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:all": "electron-builder -mwl",
    "pack": "electron-builder --dir",
    "publish": "electron-builder --linux AppImage --publish=always"
  },
  "build": {
    "appId": "com.jskids.browser",
    "productName": "JsKids Browser",
    "asar": false,
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "index.html",
      "styles.css",
      "assets/**/*"
    ],
    "linux": {
      "target": ["AppImage"],
      "category": "Network",
      "icon": "assets/icon.png"
    },
    "win": {
      "target": ["nsis", "portable"],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": ["dmg", "zip"],
      "icon": "assets/icon.png",
      "category": "public.app-category.utilities"
    }
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^26.4.0"
  }
}
